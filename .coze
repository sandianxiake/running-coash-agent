[project]
sub_id = "a1b2c3d4"
name = "running-coach-agent"
requires = ["nodejs-24"]
project_type = "web"
entrypoint = "index.html"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "running-coash-agent/scripts/coze-preview-build.sh"]
run = ["bash", "running-coash-agent/scripts/coze-preview-run.sh"]

[deploy]
build = ["bash", "running-coash-agent/scripts/build.sh"]
run = ["bash", "running-coash-agent/scripts/run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["."]
